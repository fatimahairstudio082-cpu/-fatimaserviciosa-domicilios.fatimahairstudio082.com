rules_version = '2';
// ── Reglas de seguridad de Firestore · proyecto mis-servicios-bb182 ──
// Compartidas por las dos apps de servicios (Fátima Caldea + Jonatan & Fátima).
//
// IMPORTANTE: este archivo es la FUENTE DE VERDAD, pero NO se despliega solo.
// Hay que pegarlo a mano en la consola de Firebase:
//   Firebase console → Firestore Database → pestaña "Reglas" → pegar → Publicar.
//
// Principio: cualquiera puede CREAR una cita o registrar una visita (son formularios
// públicos, sin login), pero SOLO la administradora (con su correo) puede LEER,
// modificar o borrar. Así una clienta nunca ve los datos de otra.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'fatimahairstudio082@gmail.com';
    }

    function validCita() {
      let d = request.resource.data;
      return d.origen in ['caldea', 'jonatan']
        && d.telefono is string && d.telefono.size() > 0 && d.telefono.size() <= 30
        && (!('nombre' in d)     || (d.nombre is string     && d.nombre.size() <= 80))
        && (!('direccion' in d)  || (d.direccion is string  && d.direccion.size() <= 300))
        && (!('servicio' in d)   || (d.servicio is string   && d.servicio.size() <= 120))
        && (!('zona' in d)       || (d.zona is string       && d.zona.size() <= 120))
        && (!('nota' in d)       || (d.nota is string       && d.nota.size() <= 500))
        && d.estado == 'pendiente';
    }

    // Citas: crear libre (validado); leer/editar/borrar solo la administradora.
    match /citas/{id} {
      allow create: if validCita();
      allow read, update, delete: if isAdmin();
    }

    // Visitas: registrar libre (solo ciudad aproximada); leer solo la administradora.
    match /visitas/{id} {
      allow create: if request.resource.data.origen in ['caldea', 'jonatan'];
      allow read, update, delete: if isAdmin();
    }

    // Bloques (tarjetas dinámicas: Amway, enlaces, HTML): los ven todas las
    // clientas (lectura pública), pero solo la administradora los crea/edita.
    match /bloques/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Fechas/recordatorios personales de la administradora: privados por completo.
    match /fechas/{id} {
      allow read, write: if isAdmin();
    }

    // Créditos por clienta (herramientas Pro). Cada clienta entra con identidad
    // ANÓNIMA y su saldo vive en creditos/{uid}. Reglas de seguridad:
    //   · Una clienta solo lee SU documento; la administradora lee todos.
    //   · Al crear, el saldo inicial debe ser exactamente 50 (regalo de prueba).
    //   · Una clienta solo puede BAJAR su saldo (gastar), nunca subírselo.
    //   · Solo la administradora (por correo) puede recargar/subir o borrar.
    // Requiere activar "Acceso anónimo" en Authentication.
    match /creditos/{uid} {
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.saldo == 50;
      allow update: if isAdmin()
                    || (request.auth != null && request.auth.uid == uid
                        && request.resource.data.saldo is int
                        && request.resource.data.saldo >= 0
                        && request.resource.data.saldo <= resource.data.saldo);
      allow delete: if isAdmin();
    }

    // Todo lo demás: cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
